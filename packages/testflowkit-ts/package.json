{
  "name": "@testflowkit/ts",
  "version": "0.1.0",
  "description": "TestFlowKit for TypeScript — Gherkin step sentences on Playwright + CucumberJS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node22 --dts --clean --out-dir dist",
    "dev": "tsup src/index.ts --format esm --platform node --target node22 --dts --watch --out-dir dist",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "e2e": "cucumber-js"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^25.9.6",
    "playwright": "^1.48.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "testflowkit",
    "cucumber",
    "playwright",
    "gherkin",
    "bdd",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TestFlowKit/testflowkit"
  }
}
